# --- AgroSmart SDK -----------------------------------------
# Token de acesso à API interna da AgroSmart.
AGROSMART_SDK_TOKEN=seu_token_da_api_agrosmart_aqui
# ID do dataset a ser baixado (UUID do projeto no portal AgroSmart).
AGROSMART_DATASET_ID=seu_dataset_id_aqui
# URL base da API (raramente precisa mudar).
# AGROSMART_API_URL=https://api.globalagrosmart.com.br

# --- Roboflow ----------------------------------------------
# Chave de API da conta Roboflow.
ROBOFLOW_API_KEY=sua_chave_do_roboflow_aqui
# Workspace, projeto e versão (raramente mudam; mas podem ser sobrescritos).
# ROBOFLOW_WORKSPACE=global-mapeamento
# ROBOFLOW_PROJECT=talhao-agrosmart-onarz
# ROBOFLOW_VERSION=10

# --- Paths (opcionais) -----------
# DATASET_DIR=dataset
# AGROSMART_DATASET_NAME=Talhao-GlobalDrones
# ROBOFLOW_DATASET_NAME=Talhao-Roboflow
# RUNS_DIR=runs
# CONFIGS_DIR=configs
# TRAIN_CONFIG_FILE=train_params.yaml

# --- Split do dataset --------------------------------------
# SPLIT_RANDOM_SEED=42
# SPLIT_TRAIN_RATIO=0.7
# SPLIT_VAL_RATIO=0.15
# SPLIT_TEST_RATIO=0.15
