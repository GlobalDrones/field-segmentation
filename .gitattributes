# Normalize line endings to LF on all platforms
* text=auto eol=lf

# Python source files
*.py text eol=lf

# Config files
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.env* text eol=lf

# Binary files — do not normalize
*.pt      binary
*.onnx    binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.tif     binary
*.tiff    binary

